@implements IDisposable
@inject NavigationManager NavigationManager

<div class="p-6">
    <div class="flex flex-col items-center justify-center text-center gap-2">
        <div class="w-20 h-20 rounded-2xl overflow-hidden shadow-sm shrink-0 bg-white p-1 border border-el-pink-100">
            <img src="images/logo.jpg" alt="Logo" class="w-full h-full object-contain" />
        </div>
        <div>
            <h1 class="text-base font-bold text-gray-800 leading-tight">EL Glamorous</h1>
            <p class="text-xs text-gray-500 leading-tight">Face and Body Clinic</p>
            <p class="text-[10px] text-el-pink-500 font-semibold uppercase tracking-wider mt-1">Point of Sale</p>
        </div>
    </div>
</div>

<nav class="flex-1 px-4 space-y-2 overflow-y-auto mt-2">
    <NavLink class="flex items-center gap-3 px-4 py-3 rounded-xl text-gray-600 hover:bg-el-pink-100 hover:text-el-pink-600 transition-colors font-medium" href="" Match="NavLinkMatch.All">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg>
        <span>Home</span>
    </NavLink>
    <NavLink class="flex items-center gap-3 px-4 py-3 rounded-xl text-gray-600 hover:bg-el-pink-100 hover:text-el-pink-600 transition-colors font-medium" href="services-admin">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.121 14.121L19 19m-7-7l7-7m-7 7l-2.879 2.879M12 12L9.121 9.121m0 5.758a3 3 0 10-4.243 4.243 3 3 0 004.243-4.243zm0-5.758a3 3 0 10-4.243-4.243 3 3 0 004.243 4.243z"></path></svg>
        <span>Services</span>
    </NavLink>
    <NavLink class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all duration-200 text-gray-600 hover:bg-white hover:text-el-pink-500 hover:shadow-sm" href="history">
        <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        <span class="font-medium text-sm">Reports</span>
    </NavLink>
    <NavLink class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all duration-200 text-gray-600 hover:bg-white hover:text-el-pink-500 hover:shadow-sm" href="orders">
        <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
        <span class="font-medium text-sm">Orders</span>
    </NavLink>
    <NavLink class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all duration-200 text-gray-600 hover:bg-white hover:text-el-pink-500 hover:shadow-sm" href="employees">
        <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
        <span class="font-medium text-sm">Employees</span>
    </NavLink>
    <NavLink class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all duration-200 text-gray-600 hover:bg-white hover:text-el-pink-500 hover:shadow-sm" href="settings">
        <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
        <span class="font-medium text-sm">Settings</span>
    </NavLink>
</nav>

<div class="p-4 border-t border-el-pink-100/50 mt-auto flex flex-col gap-2">
    <div class="flex items-center gap-3 px-4 py-3 rounded-xl bg-white shadow-sm text-sm border border-el-pink-100">
        <div class="relative flex h-3 w-3 shrink-0">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full @(IsOnline ? "bg-green-400" : "bg-red-400") opacity-75"></span>
          <span class="relative inline-flex rounded-full h-3 w-3 @(IsOnline ? "bg-green-500" : "bg-red-500")"></span>
        </div>
        <span class="font-medium text-gray-600 truncate">Branch: @(SessionState?.CurrentBranch?.Name ?? "Not Selected")</span>
    </div>
    <button @onclick="Logout" class="flex items-center justify-center gap-2 w-full px-4 py-3 rounded-xl text-red-500 hover:bg-red-50 transition-colors font-medium text-sm border border-transparent hover:border-red-100">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
        Log Out
    </button>
</div>

@code {
    [Inject] private ELGlamPOS.Services.PosSessionState SessionState { get; set; } = default!;
    [Inject] private IJSRuntime JSRuntime { get; set; } = default!;

    private bool IsOnline { get; set; } = true;
    private System.Threading.Timer? pollTimer;

    protected override void OnInitialized()
    {
        SessionState.OnChange += OnSessionStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                IsOnline = await JSRuntime.InvokeAsync<bool>("eval", "navigator.onLine");
                StateHasChanged();
            }
            catch { }

            // Poll navigator.onLine every 5 seconds for reliable status
            pollTimer = new System.Threading.Timer(async _ =>
            {
                try
                {
                    var online = await JSRuntime.InvokeAsync<bool>("eval", "navigator.onLine");
                    if (online != IsOnline)
                    {
                        IsOnline = online;
                        await InvokeAsync(StateHasChanged);
                    }
                }
                catch { }
            }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
        }
    }

    private void OnSessionStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void Logout()
    {
        SessionState.ClearSession();
        NavigationManager.NavigateTo("/login");
    }

    public void Dispose()
    {
        SessionState.OnChange -= OnSessionStateChanged;
        pollTimer?.Dispose();
    }
}
