@page "/orders"
@inject ELGlamPOS.Data.PosDbContext DbContext
@inject ELGlamPOS.Services.PosSessionState SessionState
@inject ELGlamPOS.Services.CartStateService CartState
@inject ELGlamPOS.Services.IFirebaseSyncService FirebaseSync
@inject NavigationManager NavigationManager

<div class="h-full flex flex-col p-6 overflow-hidden bg-el-pink-50/30">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6 shrink-0">
        <div>
            <h1 class="text-2xl font-bold text-gray-800">Manage Orders</h1>
            <p class="text-gray-500 text-sm">View and manage draft orders and bookings.</p>
        </div>

        @if (isAdmin || currentTab == "Bookings")
        {
            <div class="flex items-center gap-4">
                <div class="flex items-center gap-2">
                    <label class="text-sm font-medium text-gray-600">Branch:</label>
                    <select class="px-3 py-2 border border-el-pink-200 rounded-xl text-sm focus:ring-2 focus:ring-el-pink-400 focus:border-transparent outline-none bg-white" @onchange="OnBranchFilterChanged">
                        <option value="0">All Branches</option>
                        @foreach (var b in branches)
                        {
                            <option value="@b.Id" selected="@(selectedBranchFilter == b.Id)">@b.Name</option>
                        }
                    </select>
                </div>
                
                @if (currentTab == "Bookings")
                {
                    <div class="flex items-center gap-2">
                        <label class="text-sm font-medium text-gray-600">From:</label>
                        <input type="date" class="px-3 py-2 border border-el-pink-200 rounded-xl text-sm focus:ring-2 focus:ring-el-pink-400 focus:border-transparent outline-none bg-white"
                               value="@dateFrom?.ToString("yyyy-MM-dd")" @onchange="OnDateFromChanged" />
                        <label class="text-sm font-medium text-gray-600">To:</label>
                        <input type="date" class="px-3 py-2 border border-el-pink-200 rounded-xl text-sm focus:ring-2 focus:ring-el-pink-400 focus:border-transparent outline-none bg-white"
                               value="@dateTo?.ToString("yyyy-MM-dd")" @onchange="OnDateToChanged" />
                        @if (dateFrom.HasValue || dateTo.HasValue)
                        {
                            <button @onclick="ClearDateFilter" class="p-1.5 text-gray-400 hover:text-red-500 rounded-full hover:bg-red-50" title="Clear Date Filter">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                            </button>
                        }
                    </div>
                }
            </div>
        }
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="mb-4 p-3 bg-red-50 text-red-600 rounded-xl text-sm border border-red-100">@errorMessage</div>
    }
    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="mb-4 p-3 bg-green-50 text-green-600 rounded-xl text-sm border border-green-100">@successMessage</div>
    }

    <div class="flex gap-6 border-b border-gray-200 mb-6 shrink-0">
        <button @onclick='() => SwitchTab("Orders")' class="@(currentTab == "Orders" ? "text-el-pink-600 font-bold border-b-2 border-el-pink-600" : "text-gray-500 font-medium hover:text-gray-700") pb-2 px-1 transition-colors">Orders</button>
        <button @onclick='() => SwitchTab("Bookings")' class="@(currentTab == "Bookings" ? "text-el-pink-600 font-bold border-b-2 border-el-pink-600" : "text-gray-500 font-medium hover:text-gray-700") pb-2 px-1 transition-colors">
            Bookings
            @if (bookings.Count > 0)
            {
                <span class="ml-1.5 px-1.5 py-0.5 bg-el-pink-500 text-white rounded-full text-[10px] font-bold">@bookings.Count</span>
            }
        </button>
    </div>

    @if (currentTab == "Orders")
    {
        <div class="flex-1 overflow-auto glass-card rounded-2xl border border-white/40">
        <table class="w-full text-left border-collapse">
            <thead class="bg-gray-50/80 sticky top-0 z-10">
                <tr>
                    <th class="px-6 py-4 font-bold text-gray-700 border-b border-gray-100 text-xs uppercase tracking-wider">Order ID</th>
                    <th class="px-6 py-4 font-bold text-gray-700 border-b border-gray-100 text-xs uppercase tracking-wider">Date</th>
                    <th class="px-6 py-4 font-bold text-gray-700 border-b border-gray-100 text-xs uppercase tracking-wider">Created By</th>
                    @if (isAdmin)
                    {
                        <th class="px-6 py-4 font-bold text-gray-700 border-b border-gray-100 text-xs uppercase tracking-wider">Branch</th>
                    }
                    <th class="px-6 py-4 font-bold text-gray-700 border-b border-gray-100 text-xs uppercase tracking-wider">Items</th>
                    <th class="px-6 py-4 font-bold text-gray-700 border-b border-gray-100 text-xs uppercase tracking-wider">Status</th>
                    <th class="px-6 py-4 font-bold text-gray-700 border-b border-gray-100 text-xs uppercase tracking-wider text-right">Total</th>
                    <th class="px-6 py-4 font-bold text-gray-700 border-b border-gray-100 text-xs uppercase tracking-wider text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100/50">
                @foreach (var order in draftOrders.OrderByDescending(o => o.CreatedDate))
                {
                    var colSpan = isAdmin ? 8 : 7;
                    <tr class="hover:bg-white/60 transition-colors cursor-pointer @(expandedRowIds.Contains(order.Id) ? "bg-white" : "")" @onclick="() => ToggleRow(order.Id)">
                        <td class="px-6 py-4">
                            <div class="flex items-center gap-2">
                                <svg class="w-4 h-4 text-gray-400 transition-transform @(expandedRowIds.Contains(order.Id) ? "rotate-90 text-el-pink-500" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                                <span class="font-mono text-xs font-medium text-gray-600 bg-gray-100 px-2 py-1 rounded">#@order.Id.ToString("D6")</span>
                            </div>
                        </td>
                        <td class="px-6 py-4">
                            <div class="text-sm text-gray-800 font-medium">@order.CreatedDate.ToLocalTime().ToString("MMM dd, yyyy")</div>
                            <div class="text-xs text-gray-500">@order.CreatedDate.ToLocalTime().ToString("hh:mm tt")</div>
                        </td>
                        <td class="px-6 py-4 text-sm text-gray-700">@order.CreatedByEmployee?.Name</td>
                        @if (isAdmin)
                        {
                            <td class="px-6 py-4 text-sm text-gray-700">@order.Branch?.Name</td>
                        }
                        <td class="px-6 py-4">
                            <span class="bg-el-pink-100 text-el-pink-600 px-2 py-0.5 rounded-full text-xs font-bold">@order.Items.Count items</span>
                        </td>
                        <td class="px-6 py-4">
                            @if (order.Status == ELGlamPOS.Models.DraftOrderStatus.Draft)
                            {
                                <span class="px-3 py-1 bg-amber-50 text-amber-600 border border-amber-200 rounded-lg text-xs font-bold">Draft</span>
                            }
                            else if (order.Status == ELGlamPOS.Models.DraftOrderStatus.Completed)
                            {
                                <span class="px-3 py-1 bg-green-50 text-green-600 border border-green-200 rounded-lg text-xs font-bold">Completed</span>
                            }
                            else
                            {
                                <span class="px-3 py-1 bg-red-50 text-red-600 border border-red-200 rounded-lg text-xs font-bold">Cancelled</span>
                            }
                        </td>
                        <td class="px-6 py-4 text-right font-bold text-gray-800 text-sm">
                            ₱@order.Items.Sum(i => i.FinalPrice).ToString("N2")
                        </td>
                        <td class="px-6 py-4 text-right" @onclick:stopPropagation="true">
                            <div class="flex items-center justify-end gap-2">
                                @if (order.Status == ELGlamPOS.Models.DraftOrderStatus.Draft)
                                {
                                    <button @onclick="() => ContinueDraft(order)" class="px-3 py-1.5 bg-el-pink-500 hover:bg-el-pink-600 text-white rounded-lg text-xs font-bold transition-all shadow-sm flex items-center gap-1.5" title="Continue Order">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                                        Continue
                                    </button>
                                }

                                @{
                                    bool canDelete = isAdmin || ((order.Status == ELGlamPOS.Models.DraftOrderStatus.Draft || order.Status == ELGlamPOS.Models.DraftOrderStatus.Cancelled) && order.CreatedByEmployeeId == SessionState.CurrentEmployeeId);
                                }

                                @if (canDelete)
                                {
                                    <button @onclick="() => ConfirmDelete(order)" class="px-3 py-1.5 bg-red-500 hover:bg-red-600 text-white rounded-lg text-xs font-bold transition-all shadow-sm flex items-center gap-1.5" title="Delete Order">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                                        Delete
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>

                    @if (expandedRowIds.Contains(order.Id))
                    {
                        <tr class="bg-gray-50/50 border-b border-gray-100">
                            <td colspan="@colSpan" class="px-10 py-4">
                                <div class="p-5 bg-white border border-el-pink-100 rounded-xl shadow-sm space-y-4">
                                    <!-- Order Info -->
                                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 text-xs">
                                        <div>
                                            <span class="text-gray-500 block">Order ID</span>
                                            <span class="font-mono font-bold text-gray-800">#@order.Id.ToString("D6")</span>
                                        </div>
                                        <div>
                                            <span class="text-gray-500 block">Date</span>
                                            <span class="font-bold text-gray-800">@order.CreatedDate.ToLocalTime().ToString("MMM dd, yyyy hh:mm tt")</span>
                                        </div>
                                        <div>
                                            <span class="text-gray-500 block">Created By</span>
                                            <span class="font-bold text-gray-800">@(order.CreatedByEmployee?.Name ?? "Unknown")</span>
                                        </div>
                                        <div>
                                            <span class="text-gray-500 block">Branch</span>
                                            <span class="font-bold text-gray-800">@(order.Branch?.Name ?? "—")</span>
                                        </div>
                                    </div>

                                    @if (!string.IsNullOrEmpty(order.CustomerName) || !string.IsNullOrEmpty(order.CustomerContactNo))
                                    {
                                        <div class="grid grid-cols-2 gap-4 text-xs border-t border-gray-100 pt-3">
                                            @if (!string.IsNullOrEmpty(order.CustomerName))
                                            {
                                                <div>
                                                    <span class="text-gray-500 block">Customer</span>
                                                    <span class="font-bold text-gray-800">@order.CustomerName</span>
                                                </div>
                                            }
                                            @if (!string.IsNullOrEmpty(order.CustomerContactNo))
                                            {
                                                <div>
                                                    <span class="text-gray-500 block">Contact No.</span>
                                                    <span class="font-bold text-gray-800">@order.CustomerContactNo</span>
                                                </div>
                                            }
                                            @if (!string.IsNullOrEmpty(order.PaymentMethod))
                                            {
                                                <div>
                                                    <span class="text-gray-500 block">Payment Method</span>
                                                    <span class="font-bold text-gray-800">@order.PaymentMethod</span>
                                                </div>
                                            }
                                        </div>
                                    }

                                    <!-- Items Table -->
                                    <div class="border-t border-gray-100 pt-3">
                                        <h4 class="text-xs font-bold text-gray-700 uppercase tracking-wider mb-2">Services</h4>
                                        <table class="w-full text-xs text-left">
                                            <thead>
                                                <tr class="text-gray-500 border-b border-gray-100">
                                                    <th class="pb-2 font-medium">Service</th>
                                                    <th class="pb-2 font-medium">Category</th>
                                                    <th class="pb-2 font-medium">Provider</th>
                                                    <th class="pb-2 font-medium text-right">Price</th>
                                                </tr>
                                            </thead>
                                            <tbody class="divide-y divide-gray-50">
                                                @foreach (var item in order.Items)
                                                {
                                                    <tr>
                                                        <td class="py-2 font-medium text-gray-800">@item.ServiceItem?.Name</td>
                                                        <td class="py-2 text-gray-500">@(item.ServiceItem?.Category?.Name ?? "—")</td>
                                                        <td class="py-2 text-gray-600">
                                                            @if (item.AssignedEmployee != null)
                                                            {
                                                                <span>@item.AssignedEmployee.Name</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="text-amber-500 italic">Unassigned</span>
                                                            }
                                                        </td>
                                                        <td class="py-2 text-right font-medium">₱@item.FinalPrice.ToString("N2")</td>
                                                    </tr>
                                                }
                                            </tbody>
                                            <tfoot class="border-t border-gray-200">
                                                <tr>
                                                    <td colspan="3" class="pt-2 text-right font-medium text-gray-500">Subtotal</td>
                                                    <td class="pt-2 text-right font-medium text-gray-800">₱@order.Items.Sum(i => i.FinalPrice).ToString("N2")</td>
                                                </tr>
                                                @if (order.DiscountAmount > 0)
                                                {
                                                    <tr>
                                                        <td colspan="3" class="pt-1 text-right text-xs text-green-600">
                                                            Discount @(string.IsNullOrEmpty(order.DiscountDescription) ? "" : $"({order.DiscountDescription})")
                                                        </td>
                                                        <td class="pt-1 text-right font-bold text-green-600">-₱@order.DiscountAmount.ToString("N2")</td>
                                                    </tr>
                                                }
                                                <tr>
                                                    <td colspan="3" class="pt-2 text-right font-bold text-gray-800">Total</td>
                                                    <td class="pt-2 text-right font-bold text-gray-800">₱@Math.Max(0, order.Items.Sum(i => i.FinalPrice) - order.DiscountAmount).ToString("N2")</td>
                                                </tr>
                                            </tfoot>
                                        </table>
                                    </div>

                                    @if (!string.IsNullOrEmpty(order.Note))
                                    {
                                        <div class="text-xs bg-yellow-50 p-3 rounded-lg border border-yellow-100">
                                            <strong class="text-yellow-800">Note:</strong> <span class="text-yellow-700">@order.Note</span>
                                        </div>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }

                @if (draftOrders.Count == 0)
                {
                    var emptyColSpan = isAdmin ? 8 : 7;
                    <tr>
                        <td colspan="@emptyColSpan" class="px-6 py-12 text-center text-gray-500">
                            <div class="flex justify-center mb-2">
                                <svg class="w-8 h-8 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                            </div>
                            <p>No orders found.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    }
    else if (currentTab == "Bookings")
    {
        @if (isSyncing)
        {
            <div class="flex-1 flex items-center justify-center">
                <div class="flex items-center gap-3 text-gray-500">
                    <svg class="w-5 h-5 animate-spin text-el-pink-500" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
                    </svg>
                    <span class="text-sm font-medium">Syncing bookings from cloud...</span>
                </div>
            </div>
        }
        else if (bookings.Count == 0)
        {
            <div class="flex-1 flex flex-col items-center justify-center overflow-auto glass-card rounded-2xl border border-white/40 p-12 text-gray-500">
                <svg class="w-16 h-16 mb-4 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                <h3 class="text-lg font-bold text-gray-800 mb-1">No Upcoming Bookings</h3>
                <p class="text-sm text-center max-w-sm">Bookings from the online system will appear here automatically when synced. Pull to refresh or check your connection.</p>
                <button @onclick="RefreshBookings" class="mt-4 px-4 py-2 bg-el-pink-500 hover:bg-el-pink-600 text-white rounded-xl text-sm font-bold transition-all shadow-sm">
                    Refresh
                </button>
            </div>
        }
        else
        {
            <div class="flex-1 overflow-auto space-y-3">
                @foreach (var booking in bookings.OrderBy(b => b.AppointmentDate ?? b.CreatedDate))
                {
                    var apptLocal = booking.AppointmentDate?.ToLocalTime();
                    // Bookings come from external system — any logged-in user can cancel them
                    bool canDeleteBooking = isAdmin || SessionState.CurrentEmployee?.Role == ELGlamPOS.Models.EmployeeRole.Receptionist;
                    <div class="bg-white rounded-xl border border-el-pink-100 shadow-sm overflow-hidden flex flex-col transition-shadow duration-200 hover:shadow-md">
                        <!-- Header -->
                        @if (apptLocal.HasValue)
                        {
                            <div class="bg-gradient-to-r from-el-pink-500 to-el-pink-400 px-4 py-3 flex items-center justify-between">
                                <div class="flex items-center gap-2.5">
                                    <svg class="w-4 h-4 text-white/90 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                                    <div class="flex items-center gap-2">
                                        <h3 class="text-white font-bold text-lg leading-none m-0">@apptLocal.Value.ToString("hh:mm tt")</h3>
                                        <p class="text-white/80 text-xs font-medium leading-none m-0 mt-0.5">@apptLocal.Value.ToString("ddd, MMM dd yyyy")</p>
                                    </div>
                                </div>
                                <span class="px-2 py-0.5 bg-white/20 text-white border border-white/30 rounded-md text-[10px] font-bold uppercase tracking-wider backdrop-blur-sm shadow-sm leading-none flex items-center">Booking</span>
                            </div>
                        }
                        else
                        {
                            <div class="bg-gray-50 px-4 py-3 flex items-center justify-between border-b border-gray-100">
                                <div class="flex items-center gap-2.5">
                                    <svg class="w-4 h-4 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                                    <div class="flex items-center gap-2">
                                        <h3 class="text-gray-800 font-bold text-lg leading-none m-0">Walk-in Draft</h3>
                                        <p class="text-gray-500 text-xs font-medium leading-none m-0 mt-0.5">@booking.CreatedDate.ToLocalTime().ToString("MMM dd, yyyy • hh:mm tt")</p>
                                    </div>
                                </div>
                                <span class="px-2 py-0.5 bg-gray-200 text-gray-700 rounded-md text-[10px] font-bold uppercase tracking-wider shadow-sm leading-none flex items-center">Draft</span>
                            </div>
                        }
                        
                        <!-- Body -->
                        <div class="p-4">
                            <div class="flex flex-col sm:flex-row items-start justify-between gap-4">
                                <!-- Left: Customer info -->
                                <div class="flex-1 min-w-0 space-y-2 w-full">
                                    <div>
                                        <h2 class="text-lg font-bold text-gray-800 truncate">@(booking.CustomerName ?? "Walk-in Customer")</h2>
                                        <div class="flex flex-wrap items-center gap-2 mt-1">
                                            @if (!string.IsNullOrEmpty(booking.CustomerContactNo))
                                            {
                                                <span class="flex items-center gap-1 text-xs text-gray-600 bg-gray-50 px-2 py-0.5 rounded border border-gray-100">
                                                    <svg class="w-3 h-3 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
                                                    @booking.CustomerContactNo
                                                </span>
                                            }
                                            @if (!string.IsNullOrEmpty(booking.SourceAppointmentKey))
                                            {
                                                <span class="font-mono text-[10px] text-gray-500 bg-gray-50 border border-gray-100 px-1.5 py-0.5 rounded">ID: @booking.SourceAppointmentKey[..Math.Min(8, booking.SourceAppointmentKey.Length)]</span>
                                            }
                                        </div>
                                    </div>

                                    @if (!string.IsNullOrEmpty(booking.Note))
                                    {
                                        <div class="flex items-start gap-1.5 bg-yellow-50/50 border border-yellow-100 rounded-lg p-2 text-sm text-yellow-800 shadow-sm inline-flex">
                                            <svg class="w-4 h-4 text-yellow-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                                            <span class="leading-tight">@booking.Note</span>
                                        </div>
                                    }
                                </div>

                                <!-- Right: Actions & Total -->
                                <div class="flex flex-col items-end shrink-0 gap-3 w-full sm:w-[160px]">
                                    <div class="text-right w-full sm:text-right text-left">
                                        <div class="text-xl font-black text-gray-800">₱@booking.Items.Sum(i => i.FinalPrice).ToString("N2")</div>
                                    </div>

                                    <div class="flex flex-col w-full gap-2">
                                        <button @onclick="() => ProceedBookingToCheckout(booking)"
                                                class="w-full px-3 py-2 bg-gradient-to-r from-el-pink-500 to-el-pink-400 hover:from-el-pink-600 hover:to-el-pink-500 text-white rounded-lg text-sm font-bold transition-all shadow-md hover:shadow-lg flex items-center justify-center gap-1.5 transform hover:-translate-y-0.5">
                                            Checkout
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                                        </button>
                                        @if (canDeleteBooking)
                                        {
                                            <button @onclick="() => ConfirmDelete(booking)"
                                                    class="w-full px-3 py-1.5 bg-white hover:bg-red-50 text-red-500 border border-red-200 hover:border-red-300 rounded-lg text-xs font-bold transition-all shadow-sm flex items-center justify-center gap-1">
                                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                                                Cancel
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>

                            <!-- Services list -->
                            @if (booking.Items.Any())
                            {
                                <div class="mt-4 pt-3 border-t border-gray-100">
                                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
                                        @foreach (var item in booking.Items)
                                        {
                                            <div class="flex items-center justify-between p-3 bg-gray-50/80 rounded-lg border border-gray-100">
                                                <div class="flex flex-col min-w-0 gap-1.5">
                                                    <div class="flex items-center gap-2">
                                                        <div class="w-1.5 h-1.5 rounded-full bg-el-pink-400 shrink-0"></div>
                                                        <p class="font-bold text-gray-800 text-xs truncate leading-none m-0">@(item.ServiceItem?.Name ?? "Unknown Service")</p>
                                                    </div>
                                                    <p class="text-[10px] text-gray-500 truncate leading-none m-0 pl-3.5">
                                                        @if (item.AssignedEmployee != null)
                                                        {
                                                            <span>Staff: @item.AssignedEmployee.Name</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-amber-500 italic">No Staff</span>
                                                        }
                                                    </p>
                                                </div>
                                                <span class="font-bold text-gray-800 text-sm ml-2 shrink-0">₱@item.FinalPrice.ToString("N0")</span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>

@* Delete Confirmation Modal *@
@if (showDeleteConfirm && pendingDeleteOrder != null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-gray-900/60 backdrop-blur-sm p-4 animate-in fade-in duration-200">
        <div class="bg-white rounded-2xl shadow-2xl p-8 max-w-sm w-full text-center animate-in zoom-in-95 duration-200 border border-red-100">
            <div class="w-16 h-16 mx-auto bg-red-100 rounded-full flex items-center justify-center mb-4">
                <svg class="w-8 h-8 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
            </div>
            <h2 class="text-xl font-bold text-gray-800 mb-2">Delete Order?</h2>
            <p class="text-gray-600 mb-6">This will permanently delete order <strong class="font-mono">#@pendingDeleteOrder.Id.ToString("D6")</strong>. This action cannot be undone.</p>
            <div class="flex gap-3">
                <button @onclick="() => showDeleteConfirm = false" class="flex-1 py-3 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-xl font-bold transition-all">Cancel</button>
                <button @onclick="ExecuteDelete" class="flex-1 py-3 bg-red-500 hover:bg-red-600 text-white rounded-xl font-bold transition-all shadow-md">Delete</button>
            </div>
        </div>
    </div>
}

@code {
    private List<ELGlamPOS.Models.DraftOrder> draftOrders = new();
    private List<ELGlamPOS.Models.DraftOrder> bookings = new();
    private List<ELGlamPOS.Models.Branch> branches = new();
    private HashSet<int> expandedRowIds = new();
    private string errorMessage = "";
    private string successMessage = "";
    private bool showDeleteConfirm = false;
    private bool isSyncing = false;
    private ELGlamPOS.Models.DraftOrder? pendingDeleteOrder;
    private bool isAdmin = false;
    private int selectedBranchFilter = 0; // 0 = all
    private DateTime? dateFrom = null;
    private DateTime? dateTo = null;
    private string currentTab = "Orders";

    protected override async Task OnInitializedAsync()
    {
        isAdmin = SessionState.CurrentEmployee?.Role == ELGlamPOS.Models.EmployeeRole.Admin;

        branches = await Microsoft.EntityFrameworkCore.EntityFrameworkQueryableExtensions.ToListAsync(DbContext.Branches);

        if (isAdmin) selectedBranchFilter = 0;
        else selectedBranchFilter = SessionState.CurrentBranchId ?? 0;

        await LoadOrders();
        await LoadBookings();
    }

    private async Task SwitchTab(string tab)
    {
        currentTab = tab;
        if (tab == "Bookings")
            await RefreshBookings();
    }

    private async Task RefreshBookings()
    {
        isSyncing = true;
        StateHasChanged();
        try
        {
            await FirebaseSync.PullAppointmentsAsync();
        }
        catch { }
        finally
        {
            isSyncing = false;
        }
        await LoadBookings();
    }

    private async Task LoadBookings()
    {
        try
        {
            var query = DbContext.DraftOrders
                .Include(d => d.CreatedByEmployee)
                .Include(d => d.Branch)
                .Include(d => d.Items).ThenInclude(i => i.ServiceItem).ThenInclude(s => s!.Category)
                .Include(d => d.Items).ThenInclude(i => i.AssignedEmployee)
                .Where(d => d.SourceAppointmentKey != null && d.Status == ELGlamPOS.Models.DraftOrderStatus.Draft)
                .AsQueryable();

            if (selectedBranchFilter > 0)
                query = query.Where(d => d.BranchId == selectedBranchFilter);
                
            if (dateFrom.HasValue)
                query = query.Where(d => d.AppointmentDate.HasValue && d.AppointmentDate.Value.Date >= dateFrom.Value.Date);
            if (dateTo.HasValue)
                query = query.Where(d => d.AppointmentDate.HasValue && d.AppointmentDate.Value.Date <= dateTo.Value.Date);

            bookings = await Microsoft.EntityFrameworkCore.EntityFrameworkQueryableExtensions.ToListAsync(query);
        }
        catch (Exception ex)
        {
            errorMessage = "Failed to load bookings: " + ex.Message;
        }
    }

    private void ProceedBookingToCheckout(ELGlamPOS.Models.DraftOrder booking)
    {
        CartState.ClearCart();

        if (!string.IsNullOrEmpty(booking.SourceAppointmentKey))
            CartState.SetSourceAppointment(booking.SourceAppointmentKey, booking.Id);

        // Store customer info so CheckoutPage auto-fills it
        CartState.SetBookingCustomer(booking.CustomerName, booking.CustomerContactNo, booking.Note);

        bool allProvidersAssigned = true;
        foreach (var item in booking.Items)
        {
            if (item.ServiceItem == null) continue;
            CartState.AddItem(item.ServiceItem, item.FinalPrice);
            if (item.AssignedEmployeeId.HasValue && item.AssignedEmployee != null)
            {
                var lastAdded = CartState.Items.Last();
                CartState.AssignEmployee(lastAdded.Id, item.AssignedEmployeeId.Value, item.AssignedEmployee.Name);
            }
            else
            {
                allProvidersAssigned = false;
            }
        }

        if (allProvidersAssigned && booking.Items.Count > 0)
        {
            NavigationManager.NavigateTo("/checkout");
        }
        else
        {
            // Go to POS home so receptionist can select providers
            NavigationManager.NavigateTo("/");
        }
    }

    private async Task OnBranchFilterChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int branchId))
        {
            selectedBranchFilter = branchId;
            await LoadOrders();
            await LoadBookings();
        }
    }

    private async Task OnDateFromChanged(ChangeEventArgs e)
    {
        dateFrom = DateTime.TryParse(e.Value?.ToString(), out DateTime d) ? d.Date : null;
        await LoadBookings();
    }

    private async Task OnDateToChanged(ChangeEventArgs e)
    {
        dateTo = DateTime.TryParse(e.Value?.ToString(), out DateTime d) ? d.Date : null;
        await LoadBookings();
    }

    private async Task ClearDateFilter()
    {
        dateFrom = null;
        dateTo = null;
        await LoadBookings();
    }

    private async Task LoadOrders()
    {
        try
        {
            var query = DbContext.DraftOrders
                .Include(d => d.CreatedByEmployee)
                .Include(d => d.Branch)
                .Include(d => d.Items).ThenInclude(i => i.ServiceItem).ThenInclude(s => s.Category)
                .Include(d => d.Items).ThenInclude(i => i.AssignedEmployee)
                .AsQueryable();

            if (isAdmin)
            {
                if (selectedBranchFilter > 0)
                    query = query.Where(d => d.BranchId == selectedBranchFilter);
            }
            else
            {
                // Receptionist: own branch only
                if (SessionState.CurrentBranchId.HasValue)
                    query = query.Where(d => d.BranchId == SessionState.CurrentBranchId.Value);
            }

            draftOrders = await Microsoft.EntityFrameworkCore.EntityFrameworkQueryableExtensions.ToListAsync(query);
        }
        catch (Exception ex)
        {
            errorMessage = "Failed to load orders: " + ex.Message;
        }
    }

    private void ToggleRow(int id)
    {
        if (expandedRowIds.Contains(id)) expandedRowIds.Remove(id);
        else expandedRowIds.Add(id);
    }

    private void ContinueDraft(ELGlamPOS.Models.DraftOrder draft)
    {
        try
        {
            CartState.ClearCart();
            
            // Track the draft ID to avoid duplication on save
            CartState.SetSourceDraftOrder(draft.Id);
            
            // Only set Firebase key if this is a booking
            if (!string.IsNullOrEmpty(draft.SourceAppointmentKey))
                CartState.SetSourceAppointment(draft.SourceAppointmentKey, draft.Id);

            // Restore customer info (note included for regular drafts)
            CartState.SetBookingCustomer(draft.CustomerName, draft.CustomerContactNo, draft.Note);

            bool allAssigned = true;
            foreach (var item in draft.Items)
            {
                if (item.ServiceItem == null) continue;
                CartState.AddItem(item.ServiceItem, item.FinalPrice);
                if (item.AssignedEmployeeId.HasValue && item.AssignedEmployee != null)
                {
                    var lastAdded = CartState.Items.Last();
                    CartState.AssignEmployee(lastAdded.Id, item.AssignedEmployeeId.Value, item.AssignedEmployee.Name);
                }
                else
                {
                    allAssigned = false;
                }
            }

            // If cart has items and all providers assigned, go straight to checkout
            if (allAssigned && CartState.Items.Count > 0)
                NavigationManager.NavigateTo("/checkout");
            else
                NavigationManager.NavigateTo("/");
        }
        catch (Exception ex)
        {
            errorMessage = "Failed to load draft: " + ex.Message;
        }
    }

    private void ConfirmDelete(ELGlamPOS.Models.DraftOrder order)
    {
        pendingDeleteOrder = order;
        showDeleteConfirm = true;
    }

    private async Task ExecuteDelete()
    {
        showDeleteConfirm = false;
        if (pendingDeleteOrder == null) return;

        try
        {
            if (!string.IsNullOrEmpty(pendingDeleteOrder.SourceAppointmentKey) && pendingDeleteOrder.Status != ELGlamPOS.Models.DraftOrderStatus.Cancelled)
            {
                // Booking - soft delete and sync
                pendingDeleteOrder.Status = ELGlamPOS.Models.DraftOrderStatus.Cancelled;
                await FirebaseSync.UpdateAppointmentStatusAsync(pendingDeleteOrder.SourceAppointmentKey, "cancelled");
                await DbContext.SaveChangesAsync();
                successMessage = $"Booking #{pendingDeleteOrder.Id:D6} cancelled.";
            }
            else
            {
                // Regular draft order - hard delete
                DbContext.DraftOrderItems.RemoveRange(pendingDeleteOrder.Items);
                DbContext.DraftOrders.Remove(pendingDeleteOrder);

                if (pendingDeleteOrder.TransactionId.HasValue)
                {
                    var relatedTx = await DbContext.Transactions
                        .Include(t => t.Items)
                        .FirstOrDefaultAsync(t => t.Id == pendingDeleteOrder.TransactionId.Value);
                    if (relatedTx != null)
                    {
                        DbContext.TransactionItems.RemoveRange(relatedTx.Items);
                        DbContext.Transactions.Remove(relatedTx);
                    }
                }

                await DbContext.SaveChangesAsync();
                successMessage = $"Order #{pendingDeleteOrder.Id:D6} deleted.";
            }
            
            pendingDeleteOrder = null;
            await LoadOrders();
            await LoadBookings();
        }
        catch (Exception ex)
        {
            errorMessage = "Failed to delete order: " + ex.Message;
        }
    }
}
