@page "/settings"
@using Microsoft.AspNetCore.Identity
@using ELGlamPOS.Models
@inject UserManager<ApplicationUser> UserManager
@inject ELGlamPOS.Services.PosSessionState SessionState

<div class="h-full flex flex-col p-6 overflow-hidden bg-el-pink-50/30">
    <div class="mb-6 shrink-0">
        <h1 class="text-2xl font-bold text-gray-800">Account Settings</h1>
        <p class="text-gray-500 text-sm">Manage your security and login credentials.</p>
    </div>

    <div class="flex-1 overflow-auto">
        <div class="max-w-md bg-white p-8 rounded-2xl border border-el-pink-100 shadow-sm">
            @if (isLoading)
            {
                <div class="flex items-center justify-center p-8">
                    <svg class="animate-spin h-8 w-8 text-el-pink-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                </div>
            }
            else if (currentUser == null)
            {
                <div class="p-4 bg-yellow-50 text-yellow-800 rounded-xl text-sm">
                    No active user session found. Please log out and log back in.
                </div>
            }
            else
            {
                <EditForm Model="model" OnValidSubmit="SaveSettings">
                    <DataAnnotationsValidator />
                    
                    @if (!string.IsNullOrEmpty(statusMessage))
                    {
                        <div class="mb-6 p-3 rounded-xl text-sm font-medium flex items-center gap-2 @(isSuccess ? "bg-green-50 text-green-700 border border-green-100" : "bg-red-50 text-red-600 border border-red-100")">
                            @if (isSuccess)
                            {
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                            }
                            else
                            {
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                            }
                            @statusMessage
                        </div>
                    }

                    <div class="space-y-5">
                        <div>
                            <label class="block text-sm font-bold text-gray-700 mb-1">Email Address</label>
                            <InputText @bind-Value="model.Email" type="email" class="w-full px-4 py-2.5 border border-gray-200 rounded-xl focus:ring-2 focus:ring-el-pink-400 outline-none transition-all" />
                        </div>

                        <hr class="border-gray-100 my-6" />

                        <div>
                            <label class="block text-sm font-bold text-gray-700 mb-1">New Password</label>
                            <InputText @bind-Value="model.NewPassword" type="password" class="w-full px-4 py-2.5 border border-gray-200 rounded-xl focus:ring-2 focus:ring-el-pink-400 outline-none transition-all" placeholder="Leave blank to keep current password" />
                        </div>

                        <div>
                            <label class="block text-sm font-bold text-gray-700 mb-1">Confirm New Password</label>
                            <InputText @bind-Value="model.ConfirmPassword" type="password" class="w-full px-4 py-2.5 border border-gray-200 rounded-xl focus:ring-2 focus:ring-el-pink-400 outline-none transition-all" placeholder="Confirm new password" />
                        </div>

                        <div class="pt-4">
                            <button type="submit" disabled="@isSaving" class="w-full py-3 bg-gray-800 hover:bg-gray-900 text-white rounded-xl font-bold transition-all shadow-md disabled:opacity-50 flex justify-center items-center gap-2">
                                @if (isSaving)
                                {
                                    <svg class="animate-spin h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                                    <span>Saving...</span>
                                }
                                else
                                {
                                    <span>Save Changes</span>
                                }
                            </button>
                        </div>
                    </div>
                </EditForm>
            }
        </div>
    </div>
</div>

@code {
    private ApplicationUser? currentUser;
    private SettingsModel model = new();
    private bool isLoading = true;
    private bool isSaving = false;
    private string statusMessage = "";
    private bool isSuccess = false;

    protected override async Task OnInitializedAsync()
    {
        if (SessionState.CurrentUser != null)
        {
            currentUser = await UserManager.FindByIdAsync(SessionState.CurrentUser.Id);
            if (currentUser != null)
            {
                model.Email = currentUser.Email ?? "";
            }
        }
        isLoading = false;
    }

    private async Task SaveSettings()
    {
        if (currentUser == null) return;
        
        isSaving = true;
        statusMessage = "";
        StateHasChanged();

        try
        {
            // Validate password match if a new password is provided
            if (!string.IsNullOrEmpty(model.NewPassword))
            {
                if (model.NewPassword != model.ConfirmPassword)
                {
                    statusMessage = "Passwords do not match.";
                    isSuccess = false;
                    return;
                }
                
                // Password meets basic requirements
                if (model.NewPassword.Length < 6)
                {
                    statusMessage = "Password must be at least 6 characters.";
                    isSuccess = false;
                    return;
                }
            }

            // Update Email
            if (currentUser.Email != model.Email && !string.IsNullOrWhiteSpace(model.Email))
            {
                currentUser.Email = model.Email;
                currentUser.UserName = model.Email; // Keep username synced with email
                var emailResult = await UserManager.UpdateAsync(currentUser);
                if (!emailResult.Succeeded)
                {
                    statusMessage = "Failed to update email: " + string.Join(", ", emailResult.Errors.Select(e => e.Description));
                    isSuccess = false;
                    return;
                }
            }

            // Update Password
            if (!string.IsNullOrEmpty(model.NewPassword))
            {
                var removeResult = await UserManager.RemovePasswordAsync(currentUser);
                if (removeResult.Succeeded)
                {
                    var addResult = await UserManager.AddPasswordAsync(currentUser, model.NewPassword);
                    if (!addResult.Succeeded)
                    {
                        statusMessage = "Failed to set new password.";
                        isSuccess = false;
                        return;
                    }
                }
                else
                {
                    statusMessage = "Failed to remove old password.";
                    isSuccess = false;
                    return;
                }
            }

            statusMessage = "Settings saved successfully.";
            isSuccess = true;
            model.NewPassword = "";
            model.ConfirmPassword = "";
        }
        catch (Exception ex)
        {
            statusMessage = "Error saving settings: " + ex.Message;
            isSuccess = false;
        }
        finally
        {
            isSaving = false;
        }
    }

    private class SettingsModel
    {
        public string Email { get; set; } = "";
        public string NewPassword { get; set; } = "";
        public string ConfirmPassword { get; set; } = "";
    }
}
