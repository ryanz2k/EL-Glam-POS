@page "/login"
@using Microsoft.AspNetCore.Identity
@using ELGlamPOS.Models
@using ELGlamPOS.Services
@using Microsoft.EntityFrameworkCore
@inject UserManager<ApplicationUser> UserManager
@inject PosSessionState SessionState
@inject NavigationManager NavigationManager

<div class="min-h-screen flex items-center justify-center bg-el-pink-50 absolute inset-0 z-50">
    <div class="w-full max-w-md glass-panel p-8">
        <div class="text-center mb-8">
            <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-el-pink-500 to-el-pink-400 flex items-center justify-center text-white font-bold text-3xl shadow-md mx-auto mb-4">
                EL
            </div>
            <h1 class="text-2xl font-bold text-gray-800 tracking-tight">EL Glamorous</h1>
            <p class="text-sm text-gray-500 font-medium">Face and Body Clinic</p>
            <p class="text-xs text-el-pink-500 font-medium mt-2">Please log in to your account</p>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="mb-4 p-3 rounded-xl bg-red-50 text-red-600 text-sm font-medium border border-red-100 flex items-center gap-2">
                <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                @errorMessage
            </div>
        }

        <EditForm Model="loginModel" OnValidSubmit="HandleLogin">
            <DataAnnotationsValidator />
            
            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-1.5">Email Address</label>
                    <div class="relative">
                        <InputText @bind-Value="loginModel.Email" type="email" class="w-full pl-10 pr-4 py-3 border border-el-pink-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-el-pink-400 focus:border-transparent bg-white/80 shadow-sm" placeholder="jesa@salon.com" />
                        <svg class="w-5 h-5 text-gray-400 absolute left-3 top-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207"></path></svg>
                    </div>
                </div>

                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-1.5">Password</label>
                    <div class="relative">
                        <InputText @bind-Value="loginModel.Password" type="password" class="w-full pl-10 pr-4 py-3 border border-el-pink-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-el-pink-400 focus:border-transparent bg-white/80 shadow-sm" placeholder="••••••••" />
                        <svg class="w-5 h-5 text-gray-400 absolute left-3 top-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
                    </div>
                </div>

                <button type="submit" disabled="@isLoading" class="w-full mt-6 py-3.5 px-4 btn-primary rounded-xl font-bold transition-all flex items-center justify-center gap-2">
                    @if (isLoading)
                    {
                        <svg class="animate-spin h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                        <span>Signing In...</span>
                    }
                    else
                    {
                        <span>Sign In</span>
                    }
                </button>
            </div>
        </EditForm>
    </div>
</div>

@code {
    private LoginModel loginModel = new();
    private bool isLoading;
    private string? errorMessage;

    protected override void OnInitialized()
    {
        // Add default for easy testing based on seed data
        loginModel.Email = "jesa@salon.com";
        loginModel.Password = "password123";
    }

    private async Task HandleLogin()
    {
        isLoading = true;
        errorMessage = null;
        StateHasChanged();

        // Give a slight delay to show loading state nicely
        await Task.Delay(500);

        try
        {
            var user = await UserManager.Users
                .Include(u => u.Employee)
                .ThenInclude(e => e.Branch)
                .FirstOrDefaultAsync(u => u.Email == loginModel.Email);

            if (user != null && await UserManager.CheckPasswordAsync(user, loginModel.Password))
            {
                SessionState.SetSession(user, user.Employee);
                
                if (user.Employee.Role == EmployeeRole.Admin)
                {
                    NavigationManager.NavigateTo("/branch-selection");
                }
                else
                {
                    SessionState.SetBranch(user.Employee.BranchId, user.Employee.Branch);
                    NavigationManager.NavigateTo("/");
                }
            }
            else
            {
                errorMessage = "Invalid email or password.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Database error: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private class LoginModel
    {
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }
}
